{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmdoc.tokenroll.ai/schemas/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "llmdoc.config/v1"
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remindSkill": {
          "type": "boolean",
          "default": true
        },
        "preload": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
